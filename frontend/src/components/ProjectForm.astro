---
import { STATUS_LABELS, type Project, type ProjectStatus, type ProjectTypeItem } from '../lib/api';

interface Props {
  action: string;
  project?: Project;
  submitLabel: string;
  busyLabel: string;
  cancelHref: string;
  types: ProjectTypeItem[];
}

const { action, project, submitLabel, busyLabel, cancelHref, types } = Astro.props;
const statuses = Object.keys(STATUS_LABELS) as ProjectStatus[];
const currentStatus = project?.status ?? 'planning';
const currentType = project?.project_type ?? types.find((t) => t.slug === 'lainnya')?.slug ?? types[0]?.slug ?? '';
---

<form method="post" action={action} class="card form">
  <label class="field">
    <span>Nama proyek <span class="req">*</span></span>
    <input
      name="name"
      required
      maxlength="150"
      value={project?.name ?? ''}
      placeholder="Contoh: Redesign website perusahaan"
      autofocus
    />
  </label>

  <label class="field">
    <span>Deskripsi</span>
    <textarea
      name="description"
      rows="5"
      maxlength="5000"
      placeholder="Tujuan, ruang lingkup, dan catatan penting proyek">{project?.description ?? ''}</textarea>
  </label>

  <fieldset class="chips">
    <legend>Status</legend>
    {
      statuses.map((s) => (
        <label class="chip">
          <input type="radio" name="status" value={s} checked={s === currentStatus} />
          <span>{STATUS_LABELS[s]}</span>
        </label>
      ))
    }
  </fieldset>

  <fieldset class="chips">
    <legend>Jenis proyek</legend>
    {types.length === 0 && (
      <p class="hint">Belum ada jenis. <a href="/jenis">Tambahkan jenis dulu</a>.</p>
    )}
    {
      types.map((t) => (
        <label class="chip">
          <input type="radio" name="project_type" value={t.slug} checked={t.slug === currentType} />
          <span>{t.label}</span>
        </label>
      ))
    }
  </fieldset>

  <div class="form-grid two">
    <label class="field">
      <span>Tanggal mulai</span>
      <input type="date" name="start_date" value={project?.start_date ?? ''} />
    </label>
    <label class="field">
      <span>Tanggal selesai</span>
      <input type="date" name="due_date" value={project?.due_date ?? ''} />
    </label>
  </div>

  <div class="form-actions">
    <button class="btn primary" type="submit" data-busy={busyLabel}>{submitLabel}</button>
    <a href={cancelHref} class="btn ghost">Batal</a>
  </div>
</form>
