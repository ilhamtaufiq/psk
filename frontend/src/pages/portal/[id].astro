---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import InfoValue from '../../components/InfoValue.astro';
import { api, ApiError, type Project, type ProjectFile, type ProjectField, type Requirement } from '../../lib/api';
import { deadlineOf, formatBytes, formatDate, timeProgress } from '../../lib/format';

const token = Astro.locals.token as string;
const { id } = Astro.params;

let project: Project | null = null;
let files: ProjectFile[] = [];
let requirements: Requirement[] = [];
let fields: ProjectField[] = [];

try {
  [project, files, requirements, fields] = await Promise.all([
    api<Project>(`/api/projects/${id}`, { token }),
    api<ProjectFile[]>(`/api/projects/${id}/files`, { token }),
    api<Requirement[]>(`/api/projects/${id}/requirements`, { token }),
    api<ProjectField[]>(`/api/projects/${id}/fields`, { token }),
  ]);
} catch (err) {
  if (!(err instanceof ApiError && err.status === 404)) throw err;
  Astro.response.status = 404;
}

const deadline = project ? deadlineOf(project.due_date, project.status) : null;
const time = project ? timeProgress(project.start_date, project.due_date, project.status) : null;
const docs = project && project.req_total > 0 ? Math.round((project.req_done / project.req_total) * 100) : null;
---

<Layout title={project ? project.name : 'Portal klien'}>
  <a href="/portal" class="back"><Icon name="arrow-left" />Semua progres</a>

  {
    !project ? (
      <div class="card empty">
        <h2>Project tidak ditemukan</h2>
        <p>Project ini tidak ada atau belum dibagikan kepada Anda.</p>
        <a href="/portal" class="btn ghost">Kembali ke portal</a>
      </div>
    ) : (
      <>
        <article class="card detail-hero portal-hero">
          <div class="badges">
            <StatusBadge status={project.status} />
            {project.project_type_label.split(' · ').map((label) => (
              <span class="type-pill">{label}</span>
            ))}
            {deadline && project.status !== 'completed' && (
              <span class={`deadline ${deadline.tone}`}>{deadline.text}</span>
            )}
          </div>
          <h1>{project.name}</h1>
          {project.owner_name && <p class="muted">Pemilik: {project.owner_name}</p>}
          {project.description && <p class="portal-desc">{project.description}</p>}
        </article>

        <section class="section" aria-labelledby="h-ringkas">
          <h2 id="h-ringkas" class="sr-only">Ringkasan progres</h2>
          <div class="portal-summary">
            <div class="card portal-stat">
              <p class="portal-meter-label">Waktu berjalan</p>
              {time !== null ? (
                <>
                  <p class="portal-big">{time}%</p>
                  <div class="progress" role="progressbar" aria-label="Progres waktu" aria-valuemin={0} aria-valuemax={100} aria-valuenow={time}>
                    <span style={`width:${time}%`} />
                  </div>
                  <p class="muted small">{formatDate(project.start_date)} – {formatDate(project.due_date)}</p>
                </>
              ) : (
                <p class="muted small">Tanggal mulai atau selesai belum diisi.</p>
              )}
            </div>
            <div class="card portal-stat">
              <p class="portal-meter-label">Kelengkapan berkas</p>
              {docs !== null ? (
                <>
                  <p class="portal-big">{docs}%</p>
                  <div class="progress" role="progressbar" aria-label="Kelengkapan berkas" aria-valuemin={0} aria-valuemax={100} aria-valuenow={docs}>
                    <span style={`width:${docs}%`} />
                  </div>
                  <p class="muted small">{project.req_done} dari {project.req_total} item sudah ada berkasnya</p>
                </>
              ) : (
                <p class="muted small">Belum ada daftar kelengkapan.</p>
              )}
            </div>
          </div>
        </section>

        {requirements.length > 0 && (
          <section class="section" aria-labelledby="h-kelengkapan">
            <div class="section-head"><h2 id="h-kelengkapan">Kelengkapan</h2><span class="muted small">{project.req_done}/{project.req_total} terpenuhi</span></div>
            <ul class="portal-list card">
              {requirements.map((r) => (
                <li>
                  <span class={`portal-check ${r.file_count > 0 ? 'done' : ''}`} aria-hidden="true">
                    {r.file_count > 0 && <Icon name="check" />}
                  </span>
                  <span class="portal-list-main">{r.title}</span>
                  <span class="muted small">{r.file_count > 0 ? `${r.file_count} berkas` : 'Belum ada'}</span>
                </li>
              ))}
            </ul>
          </section>
        )}

        <section class="section" aria-labelledby="h-berkas">
          <div class="section-head"><h2 id="h-berkas">Berkas</h2><span class="muted small">{files.length} berkas</span></div>
          {files.length === 0 ? (
            <p class="card muted">Belum ada berkas yang diunggah.</p>
          ) : (
            <ul class="portal-list card">
              {files.map((f) => (
                <li>
                  <Icon name="file" />
                  <span class="portal-list-main">
                    <a href={`/api/files/${f.id}`} download>{f.original_name}</a>
                    <span class="muted small">{formatBytes(f.size_bytes)} · {formatDate(f.created_at)}</span>
                  </span>
                </li>
              ))}
            </ul>
          )}
        </section>

        {fields.length > 0 && (
          <section class="section" aria-labelledby="h-info">
            <div class="section-head"><h2 id="h-info">Informasi</h2></div>
            <dl class="card portal-info">
              {fields.map((f) => (
                <div>
                  <dt>{f.label}</dt>
                  <dd><InfoValue field={f} /></dd>
                </div>
              ))}
            </dl>
          </section>
        )}

        <p class="portal-foot muted small">Tampilan ini hanya baca. Untuk perubahan, hubungi pengelola project.</p>
      </>
    )
  }
</Layout>
