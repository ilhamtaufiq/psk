---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import StatusBadge from '../components/StatusBadge.astro';
import { api, type ProjectTypeItem, type ProjectStatus, type ReportResponse, STATUS_LABELS } from '../lib/api';
import { deadlineOf, formatDate } from '../lib/format';

const token = Astro.locals.token as string;
const params = Astro.url.searchParams;
const statusKeys = Object.keys(STATUS_LABELS) as ProjectStatus[];
const status = statusKeys.includes(params.get('status') as ProjectStatus) ? (params.get('status') as string) : '';

const types = await api<ProjectTypeItem[]>('/api/project-types', { token });
const requestedType = params.get('type') ?? '';
const type = types.some((t) => t.slug === requestedType) ? requestedType : '';

const qs = new URLSearchParams();
if (status) qs.set('status', status);
if (type) qs.set('type', type);
const report = await api<ReportResponse>(`/api/reports/projects${qs.toString() ? `?${qs}` : ''}`, { token });
const { summary, projects, recap } = report;
const recapTotal = recap.reduce((sum, r) => sum + r.total, 0);
const recapDone = recap.reduce((sum, r) => sum + r.done, 0);
const recapPercent = recapTotal > 0 ? Math.round((recapDone / recapTotal) * 100) : 0;
const pct = (part: number, whole: number) => (whole > 0 ? Math.round((part / whole) * 100) : 0);
const reqPercent = pct(summary.requirements_done, summary.requirements_total);
const generated = formatDate(summary.generated_at, true);
const csvHref = `/api/reports/csv${qs.toString() ? `?${qs}` : ''}`;
const filterText = [
  status ? STATUS_LABELS[status as ProjectStatus] : 'Semua status',
  type ? types.find((t) => t.slug === type)?.label ?? type : 'Semua jenis',
].join(' · ');
const roleLabel = (r: string) => (r === 'owner' ? 'Pemilik' : r === 'editor' ? 'Editor' : 'Viewer');
---

<Layout title="Laporan">
  <section class="page-head report-head screen-only">
    <div>
      <p class="eyebrow">Laporan</p>
      <h1>Laporan semua project</h1>
      <p class="muted small" style="margin-top:4px">Dibuat {generated} · mencakup project milik Anda dan yang dibagikan</p>
    </div>
    <div class="actions report-actions">
      <a href={csvHref} class="btn ghost"><Icon name="download" />Unduh CSV</a>
      <button type="button" class="btn primary" data-print><Icon name="file" />Simpan sebagai PDF</button>
    </div>
  </section>
  <p class="print-tip screen-only">Pilih "Simpan sebagai PDF" di dialog cetak. Atur tujuan dan ukuran kertas A4 bila perlu.</p>

  <form method="get" action="/laporan" class="toolbar report-filter screen-only" aria-label="Filter laporan">
    <label class="select-field">
      <span class="sr-only">Status</span>
      <Icon name="list" />
      <select name="status" data-autosubmit>
        <option value="">Semua status</option>
        {statusKeys.map((s) => <option value={s} selected={s === status}>{STATUS_LABELS[s]}</option>)}
      </select>
    </label>
    <label class="select-field">
      <span class="sr-only">Jenis</span>
      <Icon name="tag" />
      <select name="type" data-autosubmit>
        <option value="">Semua jenis</option>
        {types.map((t) => <option value={t.slug} selected={t.slug === type}>{t.label}</option>)}
      </select>
    </label>
  </form>

  <section class="kpis report-kpis screen-only" aria-label="Ringkasan laporan">
    <div class="card kpi">
      <span class="kpi-label">Project</span>
      <span class="kpi-value">{summary.total}</span>
      <span class="kpi-sub">{summary.completed} selesai</span>
    </div>
    <div class={`card kpi${summary.overdue > 0 ? ' kpi-alert' : ''}`}>
      <span class="kpi-label">Terlambat</span>
      <span class="kpi-value">{summary.overdue}</span>
      <span class="kpi-sub">melewati tenggat</span>
    </div>
    <div class="card kpi">
      <span class="kpi-label">Kelengkapan</span>
      <span class="kpi-value">{reqPercent}%</span>
      <span class="kpi-sub">{summary.requirements_done} dari {summary.requirements_total} item</span>
    </div>
    <div class="card kpi">
      <span class="kpi-label">Berkas</span>
      <span class="kpi-value">{summary.files_total}</span>
      <span class="kpi-sub">file tersimpan</span>
    </div>
    <div class="card kpi">
      <span class="kpi-label">Tiket terbuka</span>
      <span class="kpi-value">{summary.tickets_open}</span>
      <span class="kpi-sub">{summary.tickets_in_progress} dikerjakan · {summary.tickets_done} selesai</span>
    </div>
  </section>

  <section class="card report-status screen-only" aria-label="Distribusi status">
    <h2>Per status</h2>
    <div class="status-stats">
      {summary.by_status.map((s) => (
        <div class={`status-stat seg-${s.key}`}>
          <span class="status-stat-label">{s.label}</span>
          <span class="status-stat-value">{s.count}</span>
          <span class="status-stat-pct">{pct(s.count, summary.total)}% dari {summary.total}</span>
        </div>
      ))}
    </div>
  </section>

  <section class="card recap screen-only" aria-labelledby="recap-title">
    <div class="section-head">
      <h2 id="recap-title">Rekap kelengkapan</h2>
      <span class="muted small">{recapDone} dari {recapTotal} item · {recapPercent}%</span>
    </div>
    {recap.length === 0 ? (
      <p class="muted small">Belum ada item kelengkapan pada project yang dipilih.</p>
    ) : (
      <div class="recap-grid">
        {recap.map((r) => (
          <div class="recap-stat">
            <div class="recap-top">
              <span class="recap-label">{r.label}</span>
              <span class="recap-value">{r.done}<small>/{r.total}</small></span>
            </div>
            <div class="progress" role="progressbar" aria-label={`${r.label} terpenuhi ${r.percent}%`} aria-valuemin={0} aria-valuemax={100} aria-valuenow={r.percent}>
              <span style={`width:${r.percent}%`} />
            </div>
            <span class="recap-pct">{r.percent}% terpenuhi</span>
          </div>
        ))}
      </div>
    )}
  </section>

  <section class="section screen-only">
    <div class="section-head">
      <h2>Daftar project</h2>
      <span class="muted small">{projects.length} project · urut nama</span>
    </div>

    {
      projects.length === 0 ? (
        <div class="card empty">
          <img class="empty-art" src="/logo.svg" width="96" height="96" alt="" />
          <h2>Tidak ada project untuk laporan ini</h2>
          <p>Ubah filter status atau jenis, atau buat project baru.</p>
        </div>
      ) : (
        <div class="table-wrap card">
          <table class="report-table">
            <thead>
              <tr>
                <th scope="col">Nama</th>
                <th scope="col">Jenis</th>
                <th scope="col">Status</th>
                <th scope="col">Tenggat</th>
                <th scope="col">Kelengkapan</th>
                <th scope="col">Berkas</th>
                <th scope="col">Peran</th>
              </tr>
            </thead>
            <tbody>
              {projects.map((p) => {
                const d = deadlineOf(p.due_date, p.status);
                return (
                  <tr>
                    <td><a href={`/projects/${p.id}`}>{p.name}</a></td>
                    <td>{p.project_type_label}</td>
                    <td><StatusBadge status={p.status} /></td>
                    <td>
                      {p.due_date ? formatDate(p.due_date) : '—'}
                      {d && <span class={`deadline ${d.tone} cell-deadline`}>{d.text}</span>}
                    </td>
                    <td class="cell-missing">
                      <span>{p.req_total === 0 ? '—' : `${p.req_done}/${p.req_total}`}</span>
                      {p.missing_requirements.length > 0 && (
                        <ul class="missing-list" aria-label={`Belum ada berkas di ${p.name}`}>
                          {p.missing_requirements.map((t) => <li>{t}</li>)}
                        </ul>
                      )}
                    </td>
                    <td>{p.file_count}</td>
                    <td>{roleLabel(p.role)}</td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      )
    }
  </section>

  <!-- Dokumen cetak: hanya tampil saat dicetak / disimpan sebagai PDF -->
  <article class="print-doc" aria-label="Dokumen laporan">
    <header class="print-head">
      <img class="print-logo" src="/logo.svg" width="44" height="44" alt="" />
      <div class="print-title">
        <p class="print-kicker">Laporan Project</p>
        <h1>Project Selepas Kerja</h1>
        <p class="print-meta">Dibuat {generated}</p>
        <p class="print-meta">Filter: {filterText}</p>
      </div>
    </header>

    <dl class="print-kpis">
      <div><dt>Total project</dt><dd>{summary.total}</dd></div>
      <div><dt>Selesai</dt><dd>{summary.completed}</dd></div>
      <div class={summary.overdue > 0 ? 'print-warn' : ''}><dt>Terlambat</dt><dd>{summary.overdue}</dd></div>
      <div><dt>Kelengkapan</dt><dd>{reqPercent}%</dd></div>
      <div><dt>Berkas</dt><dd>{summary.files_total}</dd></div>
      <div><dt>Tiket terbuka</dt><dd>{summary.tickets_open}</dd></div>
    </dl>

    <section class="print-status-block">
      <h2>Distribusi status</h2>
      <div class="print-bar" role="img" aria-label="Distribusi status project">
        {summary.by_status.filter((s) => s.count > 0).map((s) => (
          <span class={`print-seg seg-${s.key}`} style={`flex:${s.count}`} />
        ))}
      </div>
      <div class="print-status-grid">
        {summary.by_status.map((s) => (
          <div class={`print-status-stat seg-${s.key}`}>
            <span class="print-status-label">{s.label}</span>
            <span class="print-status-value">{s.count} <em>{pct(s.count, summary.total)}%</em></span>
          </div>
        ))}
      </div>
    </section>

    <section class="print-recap">
      <h2>Rekap kelengkapan <span>({recapDone} dari {recapTotal} item · {recapPercent}%)</span></h2>
      <div class="print-recap-grid">
        {recap.map((r) => (
          <div class="print-recap-stat">
            <span class="print-recap-label">{r.label}</span>
            <span class="print-recap-value">{r.done}<small>/{r.total}</small> <em>{r.percent}%</em></span>
            <span class="print-recap-bar"><span style={`width:${r.percent}%`} /></span>
          </div>
        ))}
      </div>
    </section>

    <section class="print-list-block">
      <h2>Daftar project <span>({projects.length})</span></h2>
      {projects.length === 0 ? (
        <p class="print-empty">Tidak ada project untuk filter ini.</p>
      ) : (
        <table class="print-table">
          <colgroup>
            <col class="col-no" />
            <col class="col-name" />
            <col class="col-type" />
            <col class="col-status" />
            <col class="col-period" />
            <col class="col-due" />
            <col class="col-num" />
            <col class="col-num" />
          </colgroup>
          <thead>
            <tr>
              <th class="c-no">No</th>
              <th class="c-name">Nama project</th>
              <th>Jenis</th>
              <th>Status</th>
              <th>Periode</th>
              <th>Tenggat</th>
              <th class="c-num">Kelengkapan</th>
              <th class="c-num">Berkas</th>
            </tr>
          </thead>
          <tbody>
            {projects.map((p, i) => {
              const d = deadlineOf(p.due_date, p.status);
              return (
                <tr>
                  <td class="c-no">{i + 1}</td>
                  <td class="c-name">
                    <strong>{p.name}</strong>
                    <span class="print-role">{roleLabel(p.role)}</span>
                    {p.missing_requirements.length > 0 && (
                      <span class="print-missing">Belum ada berkas: {p.missing_requirements.join(', ')}</span>
                    )}
                  </td>
                  <td>{p.project_type_label}</td>
                  <td><span class={`print-status-pill ${p.status}`}>{STATUS_LABELS[p.status as ProjectStatus]}</span></td>
                  <td class="c-period">{formatDate(p.start_date)}<br />{formatDate(p.due_date)}</td>
                  <td>{d ? d.text : '—'}</td>
                  <td class="c-num">{p.req_total === 0 ? '—' : `${p.req_done}/${p.req_total}`}</td>
                  <td class="c-num">{p.file_count}</td>
                </tr>
              );
            })}
          </tbody>
        </table>
      )}
    </section>

    <footer class="print-foot">
      <span>Project Selepas Kerja · laporan dibuat {generated}</span>
    </footer>
  </article>
</Layout>

<script>
  document.addEventListener('click', (event) => {
    const btn = (event.target as HTMLElement).closest('button[data-print]');
    if (btn) window.print();
  });
</script>
