---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import Pagination from '../../components/Pagination.astro';
import {
  api,
  PROJECT_SORTS,
  STATUS_LABELS,
  type Project,
  type ProjectStatus,
  type ProjectTypeItem,
} from '../../lib/api';
import { deadlineOf, formatDate, timeProgress } from '../../lib/format';

const token = Astro.locals.token as string;
const params = Astro.url.searchParams;
const error = params.get('error');

const statusKeys = Object.keys(STATUS_LABELS) as ProjectStatus[];
const types = await api<ProjectTypeItem[]>('/api/project-types', { token });
const sortKeys = Object.keys(PROJECT_SORTS);

const status = statusKeys.includes(params.get('status') as ProjectStatus) ? (params.get('status') as ProjectStatus) : null;
const requestedType = params.get('type') ?? '';
const type = types.some((t) => t.slug === requestedType) ? requestedType : null;
const typeLabel = type ? types.find((t) => t.slug === type)?.label ?? null : null;
const sort = sortKeys.includes(params.get('sort') ?? '') ? (params.get('sort') as string) : 'updated';

// Gabungkan filter/urutan ke URL. Parameter kosong dibuang agar URL tetap bersih.
function listUrl(next: { status?: string | null; type?: string | null; sort?: string | null }) {
  const q = new URLSearchParams();
  const s = next.status === undefined ? status : next.status;
  const t = next.type === undefined ? type : next.type;
  const o = next.sort === undefined ? sort : next.sort;
  if (s) q.set('status', s);
  if (t) q.set('type', t);
  if (o && o !== 'updated') q.set('sort', o);
  const qs = q.toString();
  return qs ? `/projects?${qs}` : '/projects';
}

const qs = new URLSearchParams();
if (status) qs.set('status', status);
if (type) qs.set('type', type);
qs.set('sort', sort);
const allProjects = await api<Project[]>(`/api/projects?${qs.toString()}`, { token });

// Paginasi di sisi server: daftar tetap diambil lengkap, lalu diiris per halaman.
const PAGE_SIZE = 12;
const totalPages = Math.max(1, Math.ceil(allProjects.length / PAGE_SIZE));
const requestedPage = Number.parseInt(params.get('page') ?? '1', 10);
const page = Number.isFinite(requestedPage) ? Math.min(Math.max(requestedPage, 1), totalPages) : 1;
const projects = allProjects.slice((page - 1) * PAGE_SIZE, page * PAGE_SIZE);
const pageQuery = qs.toString();

const filterLabel = [status ? STATUS_LABELS[status] : null, typeLabel]
  .filter(Boolean)
  .join(' · ');
---

<Layout title="Project">
  <section class="page-head">
    <div>
      <p class="eyebrow">Daftar project</p>
      <h1>{filterLabel || 'Semua project'}</h1>
      <p class="muted small" style="margin-top:4px">
        {allProjects.length} project · diurutkan: {PROJECT_SORTS[sort].toLowerCase()}
      </p>
    </div>
    <a href="/projects/new" class="btn primary hide-mobile"><Icon name="plus" />Project baru</a>
  </section>

  {error && <div class="alert error" role="alert">{error}</div>}

  <nav class="tabs" aria-label="Filter status">
    <a href={listUrl({ status: null })} class="tab" aria-current={status === null ? 'page' : undefined}>Semua</a>
    {
      statusKeys.map((s) => (
        <a href={listUrl({ status: s })} class="tab" aria-current={status === s ? 'page' : undefined}>
          {STATUS_LABELS[s]}
        </a>
      ))
    }
  </nav>

  <form method="get" action="/projects" class="toolbar" aria-label="Cari, filter, dan urutkan project">
    <label class="search-field">
      <span class="sr-only">Cari nama project</span>
      <Icon name="search" />
      <input type="search" placeholder="Cari nama project…" autocomplete="off" data-filter-list="#project-grid" />
    </label>
    {status && <input type="hidden" name="status" value={status} />}
    <label class="select-field">
      <span class="sr-only">Jenis project</span>
      <Icon name="tag" />
      <select name="type" data-autosubmit>
        <option value="">Semua jenis</option>
        {
          types.map((t) => (
            <option value={t.slug} selected={t.slug === type}>{t.label}</option>
          ))
        }
      </select>
    </label>
    <label class="select-field">
      <span class="sr-only">Urutkan</span>
      <Icon name="sort" />
      <select name="sort" data-autosubmit>
        {
          sortKeys.map((k) => (
            <option value={k} selected={k === sort}>{PROJECT_SORTS[k]}</option>
          ))
        }
      </select>
    </label>
    <noscript><button class="btn ghost small" type="submit">Terapkan</button></noscript>
  </form>

  <p class="toolbar-note"><a href="/jenis">Kelola jenis project</a></p>

  {
    projects.length === 0 ? (
      <div class="card empty">
        <img class="empty-art" src="/logo.svg" width="96" height="96" alt="" />
        <h2>{filterLabel ? 'Tidak ada project yang cocok' : 'Belum ada project'}</h2>
        <p>
          {filterLabel
            ? 'Coba ubah filter jenis atau status, atau buat project baru.'
            : 'Buat project pertama Anda untuk mulai mencatat progres dan menyimpan berkas kerja.'}
        </p>
        <a href="/projects/new" class="btn primary"><Icon name="plus" />Buat project</a>
      </div>
    ) : (
      <ul class="grid" id="project-grid">
        {projects.map((p) => {
          const deadline = deadlineOf(p.due_date, p.status);
          const progress = timeProgress(p.start_date, p.due_date, p.status);
          return (
            <li>
              <a href={`/projects/${p.id}`} class="card project-card">
                <div class="card-top">
                  <div class="badges">
                    <StatusBadge status={p.status} />
                    {p.project_type_label.split(' · ').map((label) => (
                      <span class="type-pill">{label}</span>
                    ))}
                    {p.role !== 'owner' && (
                      <span class="type-pill share-pill">Dibagikan · {p.role === 'editor' ? 'Editor' : 'Viewer'}</span>
                    )}
                  </div>
                  <span class="count" title="Jumlah berkas">
                    <Icon name="paperclip" />
                    {p.file_count}
                  </span>
                </div>
                <h2>{p.name}</h2>
                {p.owner_name && <p class="card-owner">Pemilik: {p.owner_name}</p>}
                <p class="clamp">{p.description || 'Belum ada deskripsi'}</p>
                {progress !== null && (
                  <div
                    class="progress"
                    role="progressbar"
                    aria-label="Progres waktu"
                    aria-valuemin={0}
                    aria-valuemax={100}
                    aria-valuenow={progress}
                  >
                    <span style={`width:${progress}%`} />
                  </div>
                )}
                {p.req_total > 0 && (
                  <div class="req-summary" title="Kelengkapan berkas">
                    <Icon name="check" />
                    <span>Kelengkapan {p.req_done}/{p.req_total}</span>
                  </div>
                )}
                <div class="card-foot">
                  {deadline ? <span class={`deadline ${deadline.tone}`}>{deadline.text}</span> : <span>Tanpa tenggat</span>}
                  <span>{formatDate(p.start_date)} – {formatDate(p.due_date)}</span>
                </div>
              </a>
            </li>
          );
        })}
      </ul>
      <p class="filter-empty" data-filter-empty hidden>Tidak ada project yang cocok dengan pencarian.</p>
      <Pagination
        page={page}
        totalPages={totalPages}
        totalItems={allProjects.length}
        pageSize={PAGE_SIZE}
        path="/projects"
        query={pageQuery}
        label="Halaman project"
      />
    )
  }
</Layout>
