---
import Layout from '../../../layouts/Layout.astro';
import Icon from '../../../components/Icon.astro';
import StatusBadge from '../../../components/StatusBadge.astro';
import {
  api,
  ApiError,
  type Project,
  type ProjectFile,
  type ProjectField,
  type MemberList,
  type ProjectComment,
  type Requirement,
} from '../../../lib/api';
import { deadlineOf, fileKind, formatBytes, formatDate, timeProgress } from '../../../lib/format';
import { previewKind } from '../../../lib/preview';
import FieldForm from '../../../components/FieldForm.astro';
import InfoValue from '../../../components/InfoValue.astro';
import FilePreview from '../../../components/FilePreview.astro';

const token = Astro.locals.token as string;
const { id } = Astro.params;
const error = Astro.url.searchParams.get('error');

let project: Project | null = null;
let files: ProjectFile[] = [];
let requirements: Requirement[] = [];
let fields: ProjectField[] = [];
let members: MemberList | null = null;
let comments: ProjectComment[] = [];

try {
  [project, files, requirements, fields, members, comments] = await Promise.all([
    api<Project>(`/api/projects/${id}`, { token }),
    api<ProjectFile[]>(`/api/projects/${id}/files`, { token }),
    api<Requirement[]>(`/api/projects/${id}/requirements`, { token }),
    api<ProjectField[]>(`/api/projects/${id}/fields`, { token }),
    api<MemberList>(`/api/projects/${id}/members`, { token }),
    api<ProjectComment[]>(`/api/projects/${id}/comments`, { token }),
  ]);
} catch (err) {
  if (!(err instanceof ApiError && err.status === 404)) throw err;
  Astro.response.status = 404;
}

const deadline = project ? deadlineOf(project.due_date, project.status) : null;
const progress = project ? timeProgress(project.start_date, project.due_date, project.status) : null;

// Peran pengguna di project ini: mengatur kontrol yang ditampilkan (backend tetap memeriksa).
const role = project?.role ?? 'viewer';
const isOwner = role === 'owner';
const myId = Astro.locals.user?.id ?? '';

// Berkas dikelompokkan per item kelengkapan; sisanya tampil di "Berkas lainnya".
const filesByReq = new Map<string, ProjectFile[]>();
for (const f of files) {
  if (!f.requirement_id) continue;
  const list = filesByReq.get(f.requirement_id) ?? [];
  list.push(f);
  filesByReq.set(f.requirement_id, list);
}
const looseFiles = files.filter((f) => !f.requirement_id);
const doneCount = requirements.filter((r) => r.file_count > 0).length;
const checklistPercent = requirements.length ? Math.round((doneCount / requirements.length) * 100) : 0;
const suggestions = ['Kontrak', 'Invoice', 'Berita acara', 'Laporan akhir', 'Foto dokumentasi'];
---

<Layout title={project ? project.name : 'Tidak ditemukan'}>
  <div class={`detail ${role}`} data-live-project={project?.id}>
  {
    !project ? (
      <div class="card empty">
        <img class="empty-art" src="/logo.svg" width="96" height="96" alt="" />
        <h2>Project tidak ditemukan</h2>
        <p>Project mungkin sudah dihapus atau bukan milik Anda.</p>
        <a href="/projects" class="btn ghost">Kembali ke daftar project</a>
      </div>
    ) : (
      <>
        <a href="/projects" class="back"><Icon name="arrow-left" />Semua project</a>

        {error && <div class="alert error" role="alert" style="margin-top:12px">{error}</div>}

        <section class="card hero" id="ringkasan" style="margin-top:12px">
          <div class="hero-top">
            <StatusBadge status={project.status} />
            {project.project_type_label.split(' · ').map((label) => (
              <span class="type-pill">{label}</span>
            ))}
            {deadline && project.status !== 'completed' && <span class={`deadline ${deadline.tone}`}>{deadline.text}</span>}
          </div>

          <h1>{project.name}</h1>

          {
            progress !== null && (
              <div class="progress-block">
                <div class="progress-meta">
                  <span>Progres waktu</span>
                  <span>{progress}%</span>
                </div>
                <div
                  class="progress"
                  role="progressbar"
                  aria-label="Progres waktu"
                  aria-valuemin={0}
                  aria-valuemax={100}
                  aria-valuenow={progress}
                >
                  <span style={`width:${progress}%`} />
                </div>
              </div>
            )
          }

          <div class="action-row">
            <a href={`/projects/${project.id}/edit`} class="btn ghost can-edit">
              <Icon name="edit" />
              Ubah
            </a>
            <form method="post" action={`/api/projects/${project.id}/duplicate`} class="can-edit">
              <button class="btn ghost" type="submit" data-busy="Menduplikat…">
                <Icon name="copy" />
                Duplikat
              </button>
            </form>
            <form
              method="post"
              action={`/api/projects/${project.id}/delete`}
              class="owner-only"
              data-confirm="Hapus project ini beserta seluruh berkasnya? Tindakan ini tidak bisa dibatalkan."
            >
              <button class="btn danger" type="submit" data-busy="Menghapus…">
                <Icon name="trash" />
                Hapus
              </button>
            </form>
          </div>
        </section>

        <nav class="section-nav" aria-label="Lompat ke bagian">
          <a href="#ringkasan">Ringkasan</a>
          <a href="#informasi">Informasi</a>
          <a href="#kelengkapan">Kelengkapan</a>
          <a href="#berkas">Berkas</a>
          <a href="#anggota">Anggota</a>
          <a href="#komentar">Komentar</a>
          <a href="#deskripsi">Deskripsi</a>
        </nav>

        <dl class="facts" style="margin-top:12px">
          <div class="fact">
            <dt>Mulai</dt>
            <dd>{formatDate(project.start_date)}</dd>
          </div>
          <div class="fact">
            <dt>Selesai</dt>
            <dd>{formatDate(project.due_date)}</dd>
          </div>
          <div class="fact">
            <dt>Pemilik</dt>
            <dd>{project.owner_name || '—'}</dd>
          </div>
          <div class="fact">
            <dt>Berkas</dt>
            <dd>{project.file_count}</dd>
          </div>
          <div class="fact">
            <dt>Diperbarui</dt>
            <dd>{formatDate(project.updated_at, true)}</dd>
          </div>
        </dl>

        <section class="section" id="anggota">
          <div class="section-head">
            <h2>Anggota</h2>
            <span class="muted small">{(members?.members.length ?? 0) + 1} orang</span>
          </div>

          <div class="card members-card">
            <ul class="member-list">
              <li class="member-item">
                <div class="member-main">
                  <span class="member-name">{members?.owner.name}</span>
                  <span class="muted small">{members?.owner.email}</span>
                </div>
                <span class="role-pill owner">Pemilik</span>
              </li>
              {
                (members?.members ?? []).map((m) => (
                  <li class="member-item">
                    <div class="member-main">
                      <span class="member-name">{m.name}</span>
                      <span class="muted small">{m.email}</span>
                    </div>
                    <div class="member-tools">
                      <span class="role-pill pill-readonly">{m.role === 'editor' ? 'Editor' : 'Viewer'}</span>
                      <form method="post" action={`/api/projects/${project.id}/members/${m.user_id}/update`} class="owner-only role-form">
                        <input type="hidden" name="anchor" value="#anggota" />
                        <select name="role" aria-label={`Peran ${m.name}`} data-autosubmit>
                          <option value="editor" selected={m.role === 'editor'}>Editor</option>
                          <option value="viewer" selected={m.role === 'viewer'}>Viewer</option>
                        </select>
                      </form>
                      <form method="post" action={`/api/projects/${project.id}/members/${m.user_id}/delete`} class="owner-only"
                        data-confirm={`Keluarkan ${m.name.replace(/["'\\]/g, '')} dari project ini?`}>
                        <input type="hidden" name="anchor" value="#anggota" />
                        <button class="btn danger small" type="submit" data-busy="…">Keluarkan</button>
                      </form>
                    </div>
                  </li>
                ))
              }
            </ul>

            <form method="post" action={`/api/projects/${project.id}/members`} class="member-add owner-only">
              <input type="hidden" name="anchor" value="#anggota" />
              <label class="field">
                <span>Undang anggota lewat email</span>
                <input type="email" name="email" required autocomplete="off" inputmode="email" placeholder="email@contoh.com" />
                <span class="hint">Hanya akun yang sudah terdaftar yang bisa diundang.</span>
              </label>
              <label class="field">
                <span>Peran</span>
                <select name="role">
                  <option value="editor" selected>Editor (bisa mengubah isi project)</option>
                  <option value="viewer">Viewer (hanya melihat)</option>
                </select>
              </label>
              <div class="form-actions">
                <button class="btn primary" type="submit" data-busy="Mengundang…">Undang</button>
              </div>
            </form>

            {
              !isOwner && (
                <form method="post" action={`/api/projects/${project.id}/members/${myId}/delete`} class="leave-only"
                  data-confirm="Keluar dari project ini? Anda tidak bisa melihatnya lagi kecuali diundang ulang.">
                  <input type="hidden" name="self" value="1" />
                  <button class="btn ghost" type="submit" data-busy="Keluar…">Keluar dari project</button>
                </form>
              )
            }
          </div>
        </section>

        <section class="section" id="informasi">
          <div class="section-head">
            <h2>Informasi detail</h2>
            <span class="muted small">{fields.length} informasi</span>
          </div>

          <div class="card info-card">
            {
              fields.length === 0 ? (
                <p class="muted small">
                  Belum ada informasi. Tambahkan data project seperti nama pemohon atau alamat, lalu atur jenis dan urutannya.
                </p>
              ) : (
                <div class="info-list">
                  {fields.map((f, i) => (
                    <div class="info-item">
                      <div class="info-body">
                        <p class="info-label">{f.label}</p>
                        <div class="info-value">
                          <InfoValue field={f} />
                        </div>
                      </div>
                      <div class="info-tools can-edit">
                        <form method="post" action={`/api/fields/${f.id}/move`} class="move-form">
                          <input type="hidden" name="project_id" value={project.id} />
                          <input type="hidden" name="anchor" value="#informasi" />
                          <button class="icon-btn sm" type="submit" name="direction" value="up" disabled={i === 0} aria-label={`Naikkan ${f.label}`} title="Naikkan">
                            <Icon name="arrow-up" />
                          </button>
                          <button class="icon-btn sm" type="submit" name="direction" value="down" disabled={i === fields.length - 1} aria-label={`Turunkan ${f.label}`} title="Turunkan">
                            <Icon name="arrow-down" />
                          </button>
                        </form>
                        <details class="info-edit">
                          <summary class="icon-btn sm" aria-label={`Ubah ${f.label}`} title="Ubah">
                            <Icon name="edit" />
                          </summary>
                          <div class="info-edit-body">
                            <FieldForm
                              action={`/api/fields/${f.id}/update`}
                              projectId={project.id}
                              label={f.label}
                              fieldType={f.field_type}
                              value={f.value}
                              submitLabel="Simpan"
                              busyLabel="Menyimpan…"
                              cancelLabel="Batal"
                            />
                            <form
                              method="post"
                              action={`/api/fields/${f.id}/delete`}
                              class="info-delete"
                              data-confirm={`Hapus informasi "${f.label.replace(/["'\\]/g, '')}"?`}
                            >
                              <input type="hidden" name="project_id" value={project.id} />
                              <input type="hidden" name="anchor" value="#informasi" />
                              <button class="btn danger small" type="submit" data-busy="Menghapus…">
                                <Icon name="trash" />
                                Hapus informasi
                              </button>
                            </form>
                          </div>
                        </details>
                      </div>
                    </div>
                  ))}
                </div>
              )
            }

            <div class="info-add can-edit">
              <h3>Tambah informasi</h3>
              <div class="suggest can-edit" aria-label="Saran cepat">
                <button type="button" class="chip-suggest" data-fill="Nama pemohon" data-fill-type="text">Nama pemohon</button>
                <button type="button" class="chip-suggest" data-fill="Alamat" data-fill-type="multiline">Alamat</button>
                <button type="button" class="chip-suggest" data-fill="Nomor telepon" data-fill-type="phone">Nomor telepon</button>
                <button type="button" class="chip-suggest" data-fill="Email" data-fill-type="email">Email</button>
              </div>
              <FieldForm
                action={`/api/projects/${project.id}/fields`}
                submitLabel="Tambah informasi"
                busyLabel="Menambah…"
              />
            </div>
          </div>
        </section>

        <section class="section" id="deskripsi">
          <div class="section-head">
            <h2>Deskripsi</h2>
            <a href={`/projects/${project.id}/edit`} class="small can-edit">Ubah</a>
          </div>
          <div class="card">
            {
              project.description ? (
                <p class="description">{project.description}</p>
              ) : (
                <p class="muted">Belum ada deskripsi. <a href={`/projects/${project.id}/edit`} class="can-edit">Tambahkan sekarang</a>.</p>
              )
            }
          </div>
        </section>

        <section class="section" id="kelengkapan">
          <div class="section-head">
            <h2>Kelengkapan berkas</h2>
            {requirements.length > 0 && (
              <span class="muted small">{doneCount} dari {requirements.length} terpenuhi</span>
            )}
          </div>

          <div class="card checklist">
            {
              requirements.length > 0 && (
                <div class="checklist-meter">
                  <div class="progress" role="progressbar" aria-label="Kelengkapan berkas" aria-valuemin={0} aria-valuemax={100} aria-valuenow={checklistPercent}>
                    <span style={`width:${checklistPercent}%`} />
                  </div>
                  <p class="small muted">
                    {doneCount === requirements.length ? 'Semua berkas wajib sudah lengkap.' : `${requirements.length - doneCount} berkas belum diunggah.`}
                  </p>
                </div>
              )
            }

            <form method="post" action={`/api/projects/${project.id}/requirements`} class="req-add can-edit">
              <input type="hidden" name="anchor" value="#kelengkapan" />
              <label class="sr-only" for="req-title">Nama berkas yang wajib ada</label>
              <input
                id="req-title"
                name="title"
                required
                maxlength="150"
                placeholder="Tambahkan berkas wajib, mis. Kontrak"
                autocomplete="off"
              />
              <button class="btn primary" type="submit" data-busy="Menambah…">
                <Icon name="plus" />
                Tambah
              </button>
            </form>
            <div class="suggest can-edit" aria-label="Saran cepat">
              {
                suggestions.map((s) => (
                  <button type="button" class="chip-suggest" data-fill={s}>{s}</button>
                ))
              }
            </div>

            {
              requirements.length === 0 ? (
                <p class="muted small req-empty">
                  Belum ada daftar. Tulis dokumen yang wajib ada di project ini, lalu unggah filenya satu per satu.
                </p>
              ) : (
                <ul class="req-list">
                  {requirements.map((r) => {
                    const done = r.file_count > 0;
                    const linked = filesByReq.get(r.id) ?? [];
                    return (
                      <li class={`req-item${done ? ' is-done' : ''}`}>
                        <div class="req-head">
                          <span class="req-state" aria-hidden="true">
                            {done ? <Icon name="check" /> : <span class="req-dot" />}
                          </span>
                          <div class="req-main">
                            <div class="req-title">{r.title}</div>
                            <div class="req-sub">
                              {done ? `${r.file_count} berkas terunggah` : 'Belum ada berkas'}
                            </div>
                          </div>
                          <details class="req-menu can-edit">
                            <summary class="icon-btn" aria-label={`Opsi untuk ${r.title}`}>⋯</summary>
                            <div class="req-menu-body">
                              <form method="post" action={`/api/requirements/${r.id}/update`} class="req-rename">
                                <input type="hidden" name="project_id" value={project.id} />
                                <input type="hidden" name="anchor" value="#kelengkapan" />
                                <input name="title" value={r.title} required maxlength="150" aria-label="Ubah nama berkas" />
                                <button class="btn ghost small" type="submit" data-busy="…">Simpan</button>
                              </form>
                              <form
                                method="post"
                                action={`/api/requirements/${r.id}/delete`}
                                data-confirm="Hapus item ini dari daftar? Berkas yang sudah diunggah tetap disimpan di Berkas lainnya."
                              >
                                <input type="hidden" name="project_id" value={project.id} />
                                <button class="btn danger small" type="submit" data-busy="Menghapus…">Hapus dari daftar</button>
                              </form>
                            </div>
                          </details>
                        </div>

                        {
                          linked.length > 0 && (
                            <ul class="req-files">
                              {linked.map((f) => {
                                const kind = fileKind(f.original_name);
                                return (
                                  <li class="req-file">
                                    <span class={`file-icon sm ${kind.kind}`} aria-hidden="true">{kind.label}</span>
                                    {previewKind(f.original_name) !== 'none' && (
                                      <button type="button" class="icon-btn sm" data-preview data-id={f.id} data-name={f.original_name} aria-label={`Lihat ${f.original_name}`}>
                                        <Icon name="eye" />
                                      </button>
                                    )}
                                    <a class="req-file-name" href={`/api/files/${f.id}`} download title={f.original_name}>
                                      {f.original_name}
                                    </a>
                                    <span class="req-file-size">{formatBytes(f.size_bytes)}</span>
                                    <form
                                      method="post"
                                      action={`/api/files/${f.id}/delete`} class="can-edit"
                                      data-confirm={`Hapus berkas "${f.original_name.replace(/["'\\]/g, '')}"?`}
                                    >
                                      <input type="hidden" name="project_id" value={project.id} />
                                      <input type="hidden" name="anchor" value="#kelengkapan" />
                                      <button class="icon-btn sm" type="submit" aria-label={`Hapus ${f.original_name}`}>
                                        <Icon name="trash" />
                                      </button>
                                    </form>
                                  </li>
                                );
                              })}
                            </ul>
                          )
                        }

                        <form method="post" action={`/api/projects/${project.id}/files`} enctype="multipart/form-data" class="req-upload can-edit">
                          <input type="hidden" name="requirement_id" value={r.id} />
                          <input type="hidden" name="anchor" value="#kelengkapan" />
                          <label class="btn ghost small req-btn">
                            <Icon name="upload" />
                            <span class="req-btn-text">{done ? 'Tambah berkas' : 'Unggah berkas'}</span>
                            <input class="sr-only" type="file" name="file" required data-autoupload />
                          </label>
                        </form>

                        <form method="post" action={`/api/projects/${project.id}/files/from-url`} class="req-drive can-edit">
                          <input type="hidden" name="requirement_id" value={r.id} />
                          <input type="hidden" name="anchor" value="#kelengkapan" />
                          <label class="sr-only" for={`drive-${r.id}`}>Link Google Drive untuk {r.title}</label>
                          <input id={`drive-${r.id}`} type="url" name="url" required placeholder="Atau tempel link Google Drive" inputmode="url" autocomplete="off" />
                          <button class="btn ghost small" type="submit" data-busy="Mengambil…">Dari Drive</button>
                        </form>
                      </li>
                    );
                  })}
                </ul>
              )
            }
          </div>
        </section>

        <section class="section" id="berkas">
          <div class="section-head">
            <h2>Berkas lainnya</h2>
            <span class="muted small">{looseFiles.length} berkas · maks. 25 MB</span>
          </div>

          <form method="post" action={`/api/projects/${project.id}/files`} enctype="multipart/form-data" class="dropzone-form can-edit">
            <input type="hidden" name="anchor" value="#berkas" />
            <label class="dropzone">
              <span class="dz-ico"><Icon name="upload" /></span>
              <span class="dz-title">Ketuk untuk memilih berkas</span>
              <span class="dz-sub">PDF, gambar, dokumen, atau arsip. Berkas langsung diunggah.</span>
              <input class="sr-only" type="file" name="file" required data-autoupload />
            </label>
          </form>

          <form method="post" action={`/api/projects/${project.id}/files/from-url`} class="drive-form can-edit">
            <input type="hidden" name="anchor" value="#berkas" />
            <label class="field">
              <span>Atau ambil dari Google Drive</span>
              <input type="url" name="url" required placeholder="https://drive.google.com/file/d/…/view" inputmode="url" autocomplete="off" />
              <span class="hint">Berbagi harus diatur ke "Siapa saja yang memiliki link". Maks. 25 MB.</span>
            </label>
            <div class="form-actions">
              <button class="btn ghost" type="submit" data-busy="Mengambil…">Ambil dari Drive</button>
            </div>
          </form>

          {
            looseFiles.length === 0 ? (
              <div class="card empty">
                <img class="empty-art" src="/logo.svg" width="96" height="96" alt="" />
                <h2>Belum ada berkas lain</h2>
                <p>Berkas yang tidak masuk daftar kelengkapan akan tampil di sini.</p>
              </div>
            ) : (
              <ul class="file-list">
                {looseFiles.map((f) => {
                  const kind = fileKind(f.original_name);
                  return (
                    <li class="file-item">
                      <span class={`file-icon ${kind.kind}`} aria-hidden="true">{kind.label}</span>
                      <div style="min-width:0">
                        <div class="file-name">{f.original_name}</div>
                        <div class="file-sub">
                          {formatBytes(f.size_bytes)} · {f.uploaded_by_name} · {formatDate(f.created_at, true)}
                        </div>
                      </div>
                      <div class="file-actions">
                        {previewKind(f.original_name) !== 'none' && (
                          <button type="button" class="btn ghost small" data-preview data-id={f.id} data-name={f.original_name}>
                            <Icon name="eye" />
                            Lihat
                          </button>
                        )}
                        <a class="btn ghost small" href={`/api/files/${f.id}`} download>
                          <Icon name="download" />
                          Unduh
                        </a>
                        <form
                          method="post"
                          action={`/api/files/${f.id}/delete`} class="can-edit"
                          data-confirm={`Hapus berkas "${f.original_name.replace(/["'\\]/g, '')}"?`}
                        >
                          <input type="hidden" name="project_id" value={project.id} />
                          <input type="hidden" name="anchor" value="#berkas" />
                          <button class="btn danger small" type="submit" aria-label={`Hapus ${f.original_name}`}>
                            <Icon name="trash" />
                          </button>
                        </form>
                      </div>
                    </li>
                  );
                })}
              </ul>
            )
          }
        </section>

        <section class="section" id="komentar" aria-labelledby="h-komentar">
          <div class="section-head">
            <h2 id="h-komentar">Komentar</h2>
            <span class="muted small">{comments.length} komentar</span>
          </div>

          <form method="post" action={`/api/projects/${id}/comments`} class="card comment-form">
            <label class="field">
              <span class="sr-only">Tulis komentar</span>
              <textarea
                name="body"
                rows="3"
                maxlength="2000"
                required
                placeholder="Tulis masukan, catatan, atau pertanyaan untuk project ini…"
              ></textarea>
            </label>
            <div class="form-actions">
              <button class="btn primary" type="submit" data-busy="Mengirim…">Kirim komentar</button>
            </div>
          </form>

          {comments.length === 0 ? (
            <p class="card muted comment-empty">Belum ada komentar. Masukan Anda akan terlihat oleh semua anggota project.</p>
          ) : (
            <ul class="comment-list">
              {comments.map((c) => (
                <li class="card comment">
                  <header class="comment-head">
                    <span class="avatar-sm" aria-hidden="true">{c.author_name.trim().charAt(0).toUpperCase()}</span>
                    <div class="comment-meta">
                      <strong>{c.author_name}</strong>
                      <span class="muted small">{formatDate(c.created_at, true)}</span>
                    </div>
                    {c.can_delete && (
                      <form
                        method="post"
                        action={`/api/comments/${c.id}/delete`}
                        data-confirm="Hapus komentar ini?"
                        class="comment-del"
                      >
                        <input type="hidden" name="project_id" value={id} />
                        <button class="icon-btn sm" type="submit" aria-label="Hapus komentar">
                          <Icon name="trash" />
                        </button>
                      </form>
                    )}
                  </header>
                  <p class="comment-body">{c.body}</p>
                </li>
              ))}
            </ul>
          )}
        </section>
      </>
    )
  }

  </div>

  <FilePreview />
</Layout>

<script>
  import '../../../scripts/preview';
  import '../../../scripts/live';
</script>
