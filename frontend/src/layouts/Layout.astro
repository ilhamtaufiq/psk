---
import '../styles/global.css';
import Icon from '../components/Icon.astro';

interface Props {
  title: string;
}

const { title } = Astro.props;
const user = Astro.locals.user;
const path = Astro.url.pathname;
const isDash = path === '/dashboard';
const isReport = path === '/laporan';
const isList = path === '/projects' || (path.startsWith('/projects/') && !path.startsWith('/projects/new'));
const isNew = path.startsWith('/projects/new');
const initial = user?.name.trim().charAt(0).toUpperCase() ?? '';
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f4f5fb" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0c0f16" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <!-- Splash hanya sekali per tab; kelas ini dipasang sebelum render agar tidak berkedip -->
    <script is:inline>try{if(sessionStorage.getItem("psk-splash")){document.documentElement.classList.add("splash-done")}}catch(e){}</script>
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <title>{title} · Proyek Selepas Kerja</title>
  </head>
  <body>
    <div class="nav-progress" aria-hidden="true"></div>
    <div class="splash" aria-hidden="true">
      <img src="/splash.webp" width="360" height="640" alt="" decoding="async" />
    </div>
    <header class="topbar">
      <div class="container bar">
        <a href={user ? '/projects' : '/login'} class="brand">
          <img class="brand-logo" src="/logo.svg" width="30" height="30" alt="" />
          <span>Proyek Selepas Kerja</span>
        </a>

        {
          user && (
            <>
              <nav class="nav-links" aria-label="Utama">
                <a href="/dashboard" aria-current={isDash ? 'page' : undefined}>Dashboard</a>
                <a href="/projects" aria-current={isList ? 'page' : undefined}>Project</a>
                <a href="/laporan" aria-current={isReport ? 'page' : undefined}>Laporan</a>
                <a href="/projects/new" class="btn primary small" aria-current={isNew ? 'page' : undefined}>
                  <Icon name="plus" />
                  Project baru
                </a>
                <span class="user" title={user.email}>{user.name}</span>
                <form method="post" action="/api/logout">
                  <button class="btn ghost small" type="submit" data-busy="Keluar…">Keluar</button>
                </form>
              </nav>
              <details class="account">
                <summary class="avatar" aria-label={`Akun ${user.name}`}>{initial}</summary>
                <div class="account-menu">
                  <p class="account-name">{user.name}</p>
                  <p class="account-mail">{user.email}</p>
                  <a class="btn ghost block" href="/jenis">
                    <Icon name="tag" />
                    Jenis project
                  </a>
                  <form method="post" action="/api/logout">
                    <button class="btn ghost block" type="submit" data-busy="Keluar…">
                      <Icon name="logout" />
                      Keluar
                    </button>
                  </form>
                </div>
              </details>
            </>
          )
        }
      </div>
    </header>

    <main class="container">
      <slot />
    </main>

    {
      user && (
        <nav class="bottom-nav" aria-label="Navigasi utama">
          <a href="/dashboard" aria-current={isDash ? 'page' : undefined}>
            <Icon name="home" />
            <span>Beranda</span>
          </a>
          <a href="/projects" aria-current={isList ? 'page' : undefined}>
            <Icon name="list" />
            <span>Project</span>
          </a>
          <a href="/projects/new" aria-current={isNew ? 'page' : undefined}>
            <span class="fab"><Icon name="plus" /></span>
            <span>Baru</span>
          </a>
        </nav>
      )
    }

    <div class="toast" role="status" aria-live="polite" hidden></div>

    <dialog class="confirm-dialog" aria-labelledby="confirm-title">
      <form method="dialog" class="confirm-body">
        <h2 id="confirm-title">Konfirmasi</h2>
        <p class="confirm-msg"></p>
        <div class="confirm-actions">
          <button class="btn ghost" type="submit" value="cancel">Batal</button>
          <button class="btn danger" type="submit" value="ok">Ya, lanjutkan</button>
        </div>
      </form>
    </dialog>

    <script>
      import '../scripts/ui';

      try { sessionStorage.setItem('psk-splash', '1'); } catch (e) {}

      // Menu akun tertutup saat mengklik di luar.
      document.addEventListener('click', (event) => {
        const menu = document.querySelector<HTMLDetailsElement>('details.account');
        if (menu?.open && !menu.contains(event.target as Node)) menu.open = false;
      });

      // Tombol bertanda data-busy langsung menampilkan status saat formulir dikirim.
      document.addEventListener('submit', (event) => {
        if (event.defaultPrevented) return; // dibatalkan, mis. konfirmasi hapus ditolak
        const form = event.target as HTMLFormElement;
        const button = form.querySelector<HTMLButtonElement>('button[type="submit"][data-busy]');
        if (!button) return;
        button.disabled = true;
        button.dataset.label = button.textContent?.trim() ?? '';
        button.textContent = button.dataset.busy ?? 'Memproses…';
      });

      // Dropdown urutan/jenis langsung mengirim formulir GET saat dipilih.
      document.addEventListener('change', (event) => {
        const select = event.target as HTMLSelectElement;
        if (!select.matches('select[data-autosubmit]') || !select.form) return;
        // Field kosong dinonaktifkan agar URL tidak berisi parameter kosong (mis. ?type=).
        select.form.querySelectorAll<HTMLSelectElement>('select').forEach((el) => {
          el.disabled = el.value === '';
        });
        select.form.requestSubmit();
      });

      // Saran cepat: klik untuk mengisi nama (dan jenis, bila ada) di form terdekat.
      document.addEventListener('click', (event) => {
        const target = event.target as HTMLElement;
        const cancel = target.closest<HTMLButtonElement>('button[data-cancel]');
        if (cancel) {
          cancel.closest('details')?.removeAttribute('open');
          return;
        }
        const chip = target.closest<HTMLButtonElement>('button[data-fill]');
        if (!chip) return;
        const scope = chip.closest('.checklist, .info-add');
        const input = scope?.querySelector<HTMLInputElement>('input[name="title"], input[name="label"]');
        if (!input) return;
        input.value = chip.dataset.fill ?? '';
        const typeSelect = scope?.querySelector<HTMLSelectElement>('select[name="field_type"]');
        if (typeSelect && chip.dataset.fillType) {
          typeSelect.value = chip.dataset.fillType;
          typeSelect.dispatchEvent(new Event('change', { bubbles: true }));
        }
        input.focus();
      });

      // Formulir informasi detail: isi berubah sesuai jenis (paragraf memakai textarea).
      const INPUT_TYPES: Record<string, string> = {
        text: 'text', date: 'date', number: 'text', email: 'email', phone: 'tel', url: 'url',
      };
      document.addEventListener('change', (event) => {
        const select = event.target as HTMLSelectElement;
        if (!select.matches('select[data-field-type]') || !select.form) return;
        const isMulti = select.value === 'multiline';
        const text = select.form.querySelector<HTMLInputElement>('[data-value-text]');
        const area = select.form.querySelector<HTMLTextAreaElement>('[data-value-multiline]');
        if (text) {
          text.hidden = isMulti;
          text.disabled = isMulti;
          text.type = INPUT_TYPES[select.value] ?? 'text';
        }
        if (area) {
          area.hidden = !isMulti;
          area.disabled = !isMulti;
        }
      });

      // Saat kembali lewat riwayat (bfcache), pulihkan tombol yang masih nonaktif.
      window.addEventListener('pageshow', () => {
        document.querySelectorAll<HTMLButtonElement>('button[data-busy][disabled]').forEach((b) => {
          b.disabled = false;
          if (b.dataset.label) b.textContent = b.dataset.label;
        });
      });
    </script>
  </body>
</html>
